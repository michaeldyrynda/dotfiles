{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "warning",
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "color": "primary",
      "model": "openai/gpt-5.6-sol"
    },
    "implement-glm-fast": {
      "description": "Fast implementation worker",
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "low"
    },
    "implement-glm-balanced": {
      "description": "Balanced implementation worker",
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.3",
      "variant": "high"
    },
    "implement-gpt-fast": {
      "description": "Fast implementation worker",
      "mode": "primary",
      "model": "openai/gpt-5.4-mini",
      "variant": "low"
    },
    "implement-gpt-balanced": {
      "description": "Balanced implementation worker",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "medium"
    },
    "implement-gpt-deep": {
      "description": "Deep implementation worker",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "high"
    }
  },
  "autoupdate": true,
  "default_agent": "plan",
  "experimental": {
    "disable_paste_summary": true
  },
  "model": "openai/gpt-5.6-terra",
  "lsp": {
    "laravel-lsp": {
      "command": [
        "laravel-lsp"
      ],
      "extensions": [
        ".php",
        ".blade.php"
      ]
    }
  },
  "mcp": {
    "Solo": {
      "type": "local",
      "command": [
        "/Applications/Solo.app/Contents/MacOS/mcp"
      ]
    }
  }
}
