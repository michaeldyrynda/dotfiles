{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "warning",
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "color": "primary",
      "model": "openai/gpt-5.6-sol"
    }
  },
  "autoupdate": true,
  "default_agent": "plan",
  "experimental": {
    "disable_paste_summary": true
  },
  "model": "openai/gpt-5.6-terra",
  "lsp": {
    "laravel-lsp": {
      "command": [
        "laravel-lsp"
      ],
      "extensions": [
        ".php",
        ".blade.php"
      ]
    }
  }
}
